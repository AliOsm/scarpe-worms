+/// softbuffer 0.4 installs its own last sublayer and pins its image to the
+/// top-left. Explicitly stretch that layer's contents when we render fewer
+/// pixels. Leave bounds/contentsScale under softbuffer's display-change observer.
+/// If the layer cannot be found, use the portable full-size buffer instead.
+#[cfg(target_os = "macos")]
+fn configure_surface_scaling(window: &Window) -> bool {
+    use objc2::runtime::AnyObject;
+    use objc2::{class, msg_send};
+    use winit::raw_window_handle::{HasWindowHandle, RawWindowHandle};
+    let Ok(handle) = window.window_handle() else { return false };
+    let RawWindowHandle::AppKit(appkit) = handle.as_raw() else { return false };
+    // SAFETY: called on winit's main thread, after softbuffer has installed its
+    // CALayer on this live NSView. All methods have object arguments/results;
+    // CALayer retains the autoreleased NSString used for its gravity property.
+    unsafe {
+        let view: &AnyObject = appkit.ns_view.cast().as_ref();
+        let root: Option<&AnyObject> = msg_send![view, layer];
+        let Some(root) = root else { return false };
+        let layers: Option<&AnyObject> = msg_send![root, sublayers];
+        let Some(layers) = layers else { return false };
+        let layer: Option<&AnyObject> = msg_send![layers, lastObject];
+        let Some(layer) = layer else { return false };
+        let gravity: &AnyObject = msg_send![class!(NSString), stringWithUTF8String: c"resize".as_ptr()];
+        let _: () = msg_send![layer, setContentsGravity: gravity];
+        let current: &AnyObject = msg_send![layer, contentsGravity];
+        let matches: bool = msg_send![current, isEqual: gravity];
+        matches
+    }
+}
+
+#[cfg(not(target_os = "macos"))]
+fn configure_surface_scaling(_window: &Window) -> bool { false }
