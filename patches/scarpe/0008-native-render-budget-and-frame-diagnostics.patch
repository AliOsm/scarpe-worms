@@ -0,0 +1,110 @@
+//! Optional pixel budget for animation-heavy applications using the software
+//! renderer. Logical layout/input coordinates never change. On macOS the
+//! existing CoreAnimation surface scales the smaller image on the compositor;
+//! other backends receive a full-size, expanded buffer.
+use tiny_skia::Pixmap;
+
+#[derive(Clone, Copy, Debug)]
+pub(super) struct Resolution {
+    pub width: u32,
+    pub height: u32,
+    pub scale: f32,
+    pub divisor: u32,
+}
+
+impl Resolution {
+    pub fn new(width: u32, height: u32, scale: f32, budget: Option<u64>) -> Self {
+        let mut divisor = 1;
+        if let Some(budget) = budget.filter(|n| *n >= 65_536) {
+            divisor = ((width as f64 * height as f64 / budget as f64).sqrt().ceil() as u32).max(1);
+            while width.div_ceil(divisor) as u64 * height.div_ceil(divisor) as u64 > budget {
+                divisor += 1;
+            }
+        }
+        Self { width: width.div_ceil(divisor), height: height.div_ceil(divisor), scale: scale / divisor as f32, divisor }
+    }
+
+    pub fn from_env(width: u32, height: u32, scale: f32) -> Self {
+        let budget = std::env::var("SCARPE_NATIVE_MAX_RENDER_PIXELS").ok().and_then(|s| s.parse().ok());
+        Self::new(width, height, scale, budget)
+    }
+}
+
+/// RGBA -> softbuffer's 0RGB, also expanding integer-resolution pixels on
+/// platforms without compositor scaling. Repeated scanlines are copied whole.
+pub(super) fn write_pixels(pm: &Pixmap, buffer: &mut [u32], width: u32, divisor: u32) {
+    if divisor == 1 {
+        for (dest, pixel) in buffer.iter_mut().zip(pm.data().chunks_exact(4)) {
+            *dest = ((pixel[0] as u32) << 16) | ((pixel[1] as u32) << 8) | pixel[2] as u32;
+        }
+        return;
+    }
+    let width = width as usize;
+    let source_width = pm.width() as usize;
+    let divisor = divisor as usize;
+    for y in 0..buffer.len() / width {
+        let start = y * width;
+        if y % divisor != 0 {
+            buffer.copy_within(start - width..start, start);
+            continue;
+        }
+        let source = &pm.data()[(y / divisor) * source_width * 4..][..source_width * 4];
+        let dest = &mut buffer[start..start + width];
+        match divisor {
+            2 => expand_row::<2>(source, dest),
+            3 => expand_row::<3>(source, dest),
+            4 => expand_row::<4>(source, dest),
+            _ => for (dest, pixel) in dest.chunks_mut(divisor).zip(source.chunks_exact(4)) {
+                let rgb = ((pixel[0] as u32) << 16) | ((pixel[1] as u32) << 8) | pixel[2] as u32;
+                dest.fill(rgb);
+            }
+        }
+    }
+}
+
+fn expand_row<const N: usize>(source: &[u8], dest: &mut [u32]) {
+    let mut chunks = dest.chunks_exact_mut(N);
+    for (dest, pixel) in chunks.by_ref().zip(source.chunks_exact(4)) {
+        dest.fill(((pixel[0] as u32) << 16) | ((pixel[1] as u32) << 8) | pixel[2] as u32);
+    }
+    let tail = chunks.into_remainder();
+    if !tail.is_empty() {
+        let pixel = &source[source.len()-4..];
+        tail.fill(((pixel[0] as u32) << 16) | ((pixel[1] as u32) << 8) | pixel[2] as u32);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn budget_keeps_logical_geometry_and_bounds_work_across_display_sizes() {
+        for (w, h, scale) in [(2560, 1600, 2.0), (3840, 2400, 2.0), (5120, 2880, 2.0), (1081, 675, 1.0)] {
+            let r = Resolution::new(w, h, scale, Some(2_304_000));
+            assert!(r.width as u64 * r.height as u64 <= 2_304_000);
+            assert!((r.width as f32 / r.scale - w as f32 / scale).abs() < 1.0 / r.scale);
+            assert!((r.height as f32 / r.scale - h as f32 / scale).abs() < 1.0 / r.scale);
+        }
+        let r = Resolution::new(3840, 2400, 2.0, None);
+        assert_eq!((r.width, r.height, r.scale, r.divisor), (3840, 2400, 2.0, 1));
+    }
+
+    #[test]
+    fn expansion_converts_channels_and_clips_odd_window_edges() {
+        let mut pm = Pixmap::new(3, 2).unwrap();
+        for (i, pixel) in pm.data_mut().chunks_exact_mut(4).enumerate() {
+            pixel.copy_from_slice(&[i as u8, 20, 70, 255]);
+        }
+        for (w, h, divisor) in [(3, 2, 1), (6, 4, 2), (5, 3, 2), (7, 5, 3)] {
+            let mut buffer = vec![0; w * h];
+            write_pixels(&pm, &mut buffer, w as u32, divisor as u32);
+            for y in 0..h {
+                for x in 0..w {
+                    let i = (y / divisor) * 3 + x / divisor;
+                    assert_eq!(buffer[y*w+x], ((i as u32) << 16) | (20 << 8) | 70);
+                }
+            }
+        }
+    }
+}
