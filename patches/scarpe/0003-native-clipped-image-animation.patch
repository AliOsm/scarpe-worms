+        } else { FilterQuality::Bicubic };
+        let paint = PixmapPaint { quality, ..PixmapPaint::default() };
+        let mut held = self.clip_mask.take();
+        match self.clipping(&mut held, clip, Canvas::reach(bounds, transform, 0.0)) {
+            Clipping::Nothing => {},
