diff --git a/native/tests/image_animation.rs b/native/tests/image_animation.rs
new file mode 100644
index 0000000..c022d1b
--- /dev/null
+++ b/native/tests/image_animation.rs
@@ -0,0 +1,41 @@
+//! Animated pictures must retain their rotated silhouette inside clipped slots,
+//! and moving one small sprite must not invalidate a whole window.
+mod common;
+use common::{app, create, Harness};
+use scarpe_native::paint::damage::{FrameMemory, Repaint};
+use serde_json::json;
+use tiny_skia::{Color, Pixmap};
+
+#[test]
+fn rotating_a_clipped_picture_repaints_its_transformed_bounds() {
+    let path = std::env::temp_dir().join(format!("scarpe-rotated-{}.png", std::process::id()));
+    let mut sprite = Pixmap::new(40, 12).unwrap();
+    sprite.fill(Color::from_rgba8(18, 80, 210, 255));
+    sprite.save_png(&path).unwrap();
+    for scale in [1.0, 2.0] {
+        let mut h = Harness::new();
+        h.feed(&app(480, 320, &[
+            create(3, "Stack", 2, json!({"left": 30, "top": 30, "width": 380, "height": 250})),
+            create(4, "Image", 3, json!({"url": path, "left": 100, "top": 90, "width": 40, "height": 12,
+                "rotate_angle": 90, "transform_origin": "center"})),
+        ]));
+        let mut frame = h.rt.picture(1, scale).unwrap();
+        let mut memory = FrameMemory::default();
+        h.rt.repaint(1, &mut frame, scale, &mut memory);
+        // The vertical silhouette extends past the old 12px-high layout box.
+        let px = frame.pixel((150.0 * scale) as u32, (112.0 * scale) as u32).unwrap();
+        assert!(px.blue() > 180 && px.red() < 30, "rotation was clipped to the unrotated rectangle");
+        let mut before = h.rt.picture(1, scale).unwrap();
+        for angle in [12, 35, 80, 120, 179, 235, 310] {
+            h.feed(&format!("{}\n{{\"t\":\"flush\"}}\n", json!({"t": "props", "id": 4,
+                "props": {"rotate_angle": angle, "left": 102 + angle / 20}})));
+            let plan = h.rt.repaint(1, &mut frame, scale, &mut memory);
+            assert!(matches!(plan, Repaint::Rects(_)), "one rotating sprite repainted the whole window");
+            assert!(plan.pixels((frame.width(), frame.height())) < (frame.width() * frame.height() / 8) as u64);
+            let full = h.rt.picture(1, scale).unwrap();
+            h.rt.verify_repaint(1, &plan, &frame, scale, &full, &before).unwrap();
+            before = full;
+        }
+    }
+    std::fs::remove_file(path).unwrap();
+}
