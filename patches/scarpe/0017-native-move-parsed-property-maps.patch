+// The JSON parser already owns each property map. Move it into the message instead
+// of cloning every key, string, array and nested drawing context for every update.
+fn take_props(obj: &mut Map<String, Value>) -> Map<String, Value> {
+    match obj.remove("props") {
+        Some(Value::Object(props)) => props,
+        _ => Map::new(),
+    }
+}
