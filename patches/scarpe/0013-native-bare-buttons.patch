diff --git a/native/tests/bare_buttons.rs b/native/tests/bare_buttons.rs
new file mode 100644
index 0000000..d44273d
--- /dev/null
+++ b/native/tests/bare_buttons.rs
@@ -0,0 +1,75 @@
+mod common;
+use common::{app, create, Harness};
+use serde_json::json;
+use tiny_skia::Pixmap;
+
+const NAVY: [u8; 3] = [16, 40, 96];
+
+/// A navy window with one wide button whose face would cover (12..188, 20..60).
+fn window(color: serde_json::Value, state: Option<&str>) -> Harness {
+    let mut h = Harness::new();
+    h.feed(&app(200, 80, &[
+        create(3, "Background", 2, json!({"fill": {"rgba": [NAVY[0], NAVY[1], NAVY[2], 255]}, "curve": 0})),
+        create(4, "Button", 2, json!({"text": "Go", "left": 12, "top": 20, "width": 176, "height": 40,
+            "color": color, "text_color": {"rgba": [255, 210, 63, 255]}, "size": 18, "state": state})),
+    ]));
+    h
+}
+
+fn picture(h: &mut Harness) -> Pixmap {
+    h.rt.picture(1, 1.0).expect("a picture")
+}
+
+fn rgb(pm: &Pixmap, x: u32, y: u32) -> [u8; 3] {
+    let p = pm.pixel(x, y).unwrap().demultiply();
+    [p.red(), p.green(), p.blue()]
+}
+
+/// The brightest yellow-ish label pixel: how strongly the label paints.
+fn label_strength(pm: &Pixmap) -> u8 {
+    let mut best = 0;
+    for y in 20..60 {
+        for x in 12..188 {
+            let [r, g, _] = rgb(pm, x, y);
+            best = best.max(r.min(g));
+        }
+    }
+    best
+}
+
+#[test]
+fn a_transparent_colour_paints_no_face() {
+    let mut h = window(json!({"rgba": [0, 0, 0, 0]}), None);
+    let pm = picture(&mut h);
+    // Inside the face, away from the centred label, and along its border and shadow.
+    for (x, y) in [(20, 30), (180, 50), (12, 40), (100, 21), (100, 59)] {
+        assert_eq!(rgb(&pm, x, y), NAVY, "no face, border or shadow at {x},{y}");
+    }
+    assert!(label_strength(&pm) > 200, "the label still paints");
+}
+
+#[test]
+fn an_ordinary_button_keeps_its_face() {
+    let mut h = window(json!(null), None);
+    let pm = picture(&mut h);
+    assert_ne!(rgb(&pm, 20, 30), NAVY, "the default white face covers the window");
+}
+
+#[test]
+fn a_disabled_bare_button_fades_its_label_without_a_wash() {
+    let mut enabled = window(json!({"rgba": [0, 0, 0, 0]}), None);
+    let mut disabled = window(json!({"rgba": [0, 0, 0, 0]}), Some("disabled"));
+    let (on, off) = (picture(&mut enabled), picture(&mut disabled));
+    assert_eq!(rgb(&off, 20, 30), NAVY, "no white wash over the art behind it");
+    assert!(label_strength(&off) + 60 < label_strength(&on), "the label fades");
+    assert!(label_strength(&off) > NAVY[1], "but stays visible");
+}
+
+#[test]
+fn disabling_a_bare_button_relabels_it() {
+    let mut h = window(json!({"rgba": [0, 0, 0, 0]}), None);
+    let before = label_strength(&picture(&mut h));
+    h.feed("{\"t\":\"props\",\"id\":4,\"props\":{\"state\":\"disabled\"}}\n{\"t\":\"flush\"}\n");
+    let after = label_strength(&picture(&mut h));
+    assert!(after + 60 < before, "{after} is fainter than {before}");
+}
