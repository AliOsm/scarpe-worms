+
+#[test]
+fn an_auto_height_layout_layer_does_not_expand_sprite_damage() {
+    let mut h = Harness::new();
+    h.feed(&app(800, 600, &[
+        create(3, "Stack", 2, json!({"left": 0, "top": 0, "width": 800, "height": 600})),
+        create(4, "Stack", 3, json!({"left": 0, "top": 0, "width": 800})),
+        create(5, "Oval", 4, json!({"left": 240, "top": 250, "width": 16, "height": 16, "fill": {"rgba": [220, 80, 30, 255]}})),
+    ]));
+    let mut window = Window::open(&mut h, 2.0);
+    for y in [253, 260, 267, 278, 295] {
+        props(&mut h, 5, json!({"top": y}));
+        assert!(partial(&window.repaint(&mut h), &window, 0.04), "an empty ancestor's changing height is not damage");
+    }
+    props(&mut h, 4, json!({"left": 20, "top": 20}));
+    assert!(partial(&window.repaint(&mut h), &window, 0.06), "moving the parent still repaints its children");
+    props(&mut h, 4, json!({"hidden": true}));
+    assert!(partial(&window.repaint(&mut h), &window, 0.04));
+}
