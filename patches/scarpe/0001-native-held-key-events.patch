diff --git a/native/tests/held_keys.rs b/native/tests/held_keys.rs
new file mode 100644
index 0000000..3114f95
--- /dev/null
+++ b/native/tests/held_keys.rs
@@ -0,0 +1,52 @@
+mod common;
+use common::{app, create, events, named, Harness};
+use scarpe_native::input::KeyInput;
+use serde_json::json;
+
+fn scene() -> Harness {
+    let mut h = Harness::new();
+    h.feed(&app(300, 200, &[
+        create(3, "SubscriptionItem", 2, json!({"shoes_api_name":"keydown","args":[]})),
+        create(4, "SubscriptionItem", 2, json!({"shoes_api_name":"keyup","args":[]})),
+        create(5, "SubscriptionItem", 2, json!({"shoes_api_name":"keypress","args":[]})),
+    ]));
+    h
+}
+
+#[test]
+fn repeat_does_not_repeat_down_and_release_is_paired() {
+    let mut h = scene();
+    let (evs, _) = h.req(json!({"op":"key_down","key":"left"}));
+    assert_eq!(named(&events(&evs), "keydown").len(), 1);
+    let (evs, _) = h.req(json!({"op":"key_down","key":"left"}));
+    assert!(named(&events(&evs), "keydown").is_empty());
+    assert_eq!(named(&events(&evs), "keypress").len(), 1);
+    let (evs, _) = h.req(json!({"op":"key_up","key":"left"}));
+    assert_eq!(named(&events(&evs), "keyup")[0].2, json!([":left"]));
+    let (evs, _) = h.req(json!({"op":"key_up","key":"left"}));
+    assert!(named(&events(&evs), "keyup").is_empty());
+}
+
+#[test]
+fn focus_loss_releases_every_key_and_captured_name_survives_modifier_changes() {
+    let mut h = scene();
+    h.rt.key_input_named(1, KeyInput::parse("A").unwrap(), "physical-a".into());
+    h.rt.key_input_named(1, KeyInput::parse("left").unwrap(), "physical-left".into());
+    h.rt.out.take_captured();
+    h.rt.key_release_named(1, "physical-a");
+    let evs = events(&h.rt.out.take_captured());
+    assert_eq!(named(&evs, "keyup")[0].2, json!(["A"]));
+    h.rt.release_keys(1);
+    let evs = events(&h.rt.out.take_captured());
+    assert_eq!(named(&evs, "keyup")[0].2, json!([":left"]));
+    assert!(h.rt.views[&1].ui.held_keys.is_empty());
+}
+
+#[test]
+fn typing_does_not_start_game_movement() {
+    let mut h = scene();
+    h.feed(&create(6, "EditLine", 2, json!({"text":"","width":200,"height":30})).to_string());
+    h.value(json!({"op":"click","target":{"id":6}}));
+    let (evs, _) = h.req(json!({"op":"key_down","key":"a"}));
+    assert!(named(&events(&evs), "keydown").is_empty());
+}
