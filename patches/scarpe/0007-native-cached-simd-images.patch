+    let pm = Pixmap::new(21, 21).unwrap();
+    pm.save_png(&path).unwrap();
+    cache.next_batch();
+    cache.get(&path).unwrap();
+    assert!(!cache.is_opaque(&path));
+    assert!(cache.at_size(&path, 70, 50).unwrap().data().iter().all(|n| *n == 0));
