+    let path = scratch("premultiplied").join("sprite.png");
+    let mut pm = Pixmap::new(24, 16).unwrap();
+    for (i, pixel) in pm.pixels_mut().iter_mut().enumerate() {
+        let alpha = ((i % 24) * 255 / 23) as u8;
+        *pixel = Color::from_rgba8(255, 0, 0, alpha).premultiply().to_color_u8();
