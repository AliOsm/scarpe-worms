--- /dev/null
+++ b/native/src/paint/image_runs.rs
@@ -0,0 +1,56 @@
+//! Alpha runs computed once per decoded/resized picture. Large opaque terrain
+//! and backgrounds copy scanlines; empty spans do no work. Only soft edges blend.
+use tiny_skia::PixmapRef;
+
+pub struct ImageRuns {
+    width: u32,
+    rows: Vec<usize>,
+    spans: Vec<Run>,
+}
+
+pub(super) struct Run {
+    pub left: usize,
+    pub right: usize,
+    pub opaque: bool,
+}
+
+impl ImageRuns {
+    /// Returns None when fragmented alpha would make the index expensive. The
+    /// caller then blends normally. Metadata is bounded by the pixel buffer's
+    /// size (apart from tiny images), and never exceeds 262,144 spans.
+    pub fn new(image: PixmapRef<'_>) -> Option<Self> {
+        let limit = (image.data().len() / std::mem::size_of::<Run>()).clamp(64, 262_144);
+        let mut rows = Vec::with_capacity(image.height() as usize + 1);
+        let mut spans = Vec::new();
+        for row in image.data().chunks_exact(image.width() as usize * 4) {
+            rows.push(spans.len());
+            let mut x = 0;
+            while x < image.width() as usize {
+                let alpha = row[x * 4 + 3];
+                let class = if alpha == 0 { 0 } else if alpha == 255 { 2 } else { 1 };
+                let left = x;
+                x += 1;
+                while x < image.width() as usize {
+                    let a = row[x * 4 + 3];
+                    let next = if a == 0 { 0 } else if a == 255 { 2 } else { 1 };
+                    if next != class { break; }
+                    x += 1;
+                }
+                if class != 0 {
+                    if spans.len() == limit { return None; }
+                    spans.push(Run {left, right: x, opaque: class == 2});
+                }
+            }
+        }
+        rows.push(spans.len());
+        Some(Self { width: image.width(), rows, spans })
+    }
+
+    pub(super) fn fits(&self, image: PixmapRef<'_>) -> bool {
+        self.width == image.width() && self.rows.len() == image.height() as usize + 1
+    }
+
+    pub(super) fn row(&self, y: usize) -> &[Run] {
+        &self.spans[self.rows[y]..self.rows[y + 1]]
+    }
+}
