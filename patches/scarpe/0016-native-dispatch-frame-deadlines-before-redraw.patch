diff --git a/native/tests/frame_deadlines.rs b/native/tests/frame_deadlines.rs
new file mode 100644
index 0000000..7f0bce2
--- /dev/null
+++ b/native/tests/frame_deadlines.rs
@@ -0,0 +1,66 @@
+//! Event order matters on AppKit: NewEvents, user messages, queued redraws,
+//! then AboutToWait. Exercise deadlines without depending on a desktop timer.
+
+use scarpe_native::window::pacing::Pacing;
+use std::time::{Duration, Instant};
+
+fn waiting_frame() -> (Pacing, Instant) {
+    let mut pacing = Pacing::new(Some(60_000));
+    let started = Instant::now();
+    pacing.drawing(started);
+    assert!(!pacing.want_frame(started + Duration::from_millis(4)));
+    let due = pacing.due().unwrap();
+    (pacing, due)
+}
+
+#[test]
+fn waking_for_a_frame_queues_it_before_the_platform_drains_redraws() {
+    let (mut pacing, due) = waiting_frame();
+    let mut redraws = 0;
+    // Shell::new_events: the deadline is handled in this event-loop turn.
+    if pacing.take_due(due, true).is_some() { redraws += 1; }
+    // AppKit drains queued redraws before Shell::about_to_wait.
+    assert_eq!(std::mem::take(&mut redraws), 1);
+    // The fallback must not queue a duplicate frame.
+    assert!(pacing.take_due(due, true).is_none());
+
+    let (mut old_pacing, old_due) = waiting_frame();
+    let mut old_redraws = 0;
+    // The previous handler only queued at AboutToWait, after this drain.
+    assert_eq!(std::mem::take(&mut old_redraws), 0);
+    if old_pacing.take_due(old_due, true).is_some() { old_redraws += 1; }
+    assert_eq!(old_redraws, 1, "the previous event order needs another turn");
+}
+
+#[test]
+fn incomplete_batches_keep_their_deadline_without_presenting_half_a_frame() {
+    let (mut pacing, due) = waiting_frame();
+    let later = due + Duration::from_millis(6);
+    assert!(pacing.take_due(due, false).is_none());
+    assert!(pacing.take_due(later, false).is_none());
+    assert_eq!(pacing.due(), Some(due));
+    assert_eq!(pacing.take_due(later, true), Some(Duration::from_millis(6)));
+    assert!(pacing.due().is_none());
+}
+
+#[test]
+fn event_work_crossing_the_deadline_uses_the_fallback_and_records_lateness() {
+    let (mut pacing, due) = waiting_frame();
+    assert!(pacing.take_due(due - Duration::from_millis(1), true).is_none());
+    assert_eq!(pacing.take_due(due + Duration::from_millis(2), true), Some(Duration::from_millis(2)));
+}
+
+#[test]
+fn idle_input_stays_immediate_and_frame_work_does_not_shift_the_deadline() {
+    let mut pacing = Pacing::new(Some(60_000));
+    let started = Instant::now();
+    pacing.drawing(started);
+    // Six ms spent drawing must count inside the refresh interval.
+    assert!(!pacing.want_frame(started + Duration::from_millis(6)));
+    let due = pacing.due().unwrap();
+    assert!(due < started + Duration::from_millis(17));
+    assert_eq!(pacing.take_due(due, true), Some(Duration::ZERO));
+    pacing.drawing(due);
+    assert!(pacing.want_frame(started + Duration::from_millis(100)));
+    assert!(pacing.due().is_none());
+}
