+/// Thread CPU time is sampled beside wall time for native phase diagnostics. The
+/// fallback keeps the instrumentation portable on targets without a POSIX clock.
+#[cfg(unix)]
+pub fn thread_cpu_now() -> Duration {
+    let mut value = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+    // CLOCK_THREAD_CPUTIME_ID is available on Linux and macOS and measures only
+    // this event-loop thread, excluding time descheduled by the OS.
+    let result = unsafe { libc::clock_gettime(libc::CLOCK_THREAD_CPUTIME_ID, &mut value) };
+    if result == 0 && value.tv_sec >= 0 && value.tv_nsec >= 0 {
+        Duration::new(value.tv_sec as u64, value.tv_nsec as u32)
+    } else {
+        Duration::ZERO
+    }
+}
+
+#[cfg(not(unix))]
+pub fn thread_cpu_now() -> Duration {
+    Duration::ZERO
+}
