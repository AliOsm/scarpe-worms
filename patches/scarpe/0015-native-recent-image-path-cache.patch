+
+    /// Bytes held by the run index, including the capacity reserved by its vectors.
+    ///
+    /// The image cache uses this when bounding recently-unshown pictures.  Counting
+    /// capacities (rather than only lengths) keeps the bound conservative when a
+    /// fragmented-alpha image caused the vectors to grow before the index was kept.
+    pub(crate) fn bytes(&self) -> usize {
+        std::mem::size_of::<Self>()
+            + self.rows.capacity() * std::mem::size_of::<usize>()
+            + self.spans.capacity() * std::mem::size_of::<Run>()
+    }
 }
diff --git a/native/tests/image_retention.rs b/native/tests/image_retention.rs
new file mode 100644
index 0000000..55ea738
--- /dev/null
+++ b/native/tests/image_retention.rs
@@ -0,0 +1,135 @@
+//! Recently-unshown pictures stay warm for a bounded time, and a retained entry
+//! still revalidates its file metadata before it is used again.
+
+use scarpe_native::elements::image::ImageCache;
+use std::path::{Path, PathBuf};
+use std::rc::Rc;
+use tiny_skia::{Color, Pixmap};
+
+fn scratch(name: &str) -> PathBuf {
+    let dir = std::env::temp_dir().join(format!("scarpe-native-image-retention-{}-{name}", std::process::id()));
+    std::fs::create_dir_all(&dir).unwrap();
+    dir
+}
+
+fn png(path: &Path, side: u32, rgb: [u8; 3]) {
+    let mut pm = Pixmap::new(side, side).unwrap();
+    pm.fill(Color::from_rgba8(rgb[0], rgb[1], rgb[2], 255));
+    pm.save_png(path).unwrap();
+}
+
+#[test]
+fn cycling_animation_paths_reuses_decodes_and_size_copies() {
+    let dir = scratch("animation");
+    let paths: Vec<_> = (0..4).map(|i| {
+        let path = dir.join(format!("frame{i}.png"));
+        png(&path, 32, [i * 50, 40, 100]);
+        path
+    }).collect();
+    let mut cache = ImageCache::default();
+    let mut original = Vec::new();
+    for path in &paths {
+        original.push(cache.get(path).unwrap());
+    }
+    for frame in 0..60 {
+        let i = frame % paths.len();
+        cache.next_batch();
+        cache.retain(|path| path == paths[i]);
+        assert!(Rc::ptr_eq(&original[i], &cache.get(&paths[i]).unwrap()), "returning to a path reuses its decode");
+        cache.at_size(&paths[i], 21, 21).unwrap();
+    }
+    assert_eq!(cache.take_resampled(), 4, "each animation frame is resized just once");
+}
+
+#[test]
+fn inactive_entries_are_bounded_by_count_while_shown_entries_stay() {
+    let dir = scratch("count");
+    let paths: Vec<_> = (0..80)
+        .map(|i| {
+            let path = dir.join(format!("{i}.png"));
+            png(&path, 2, [i as u8, 0, 0]);
+            path
+        })
+        .collect();
+    let mut cache = ImageCache::default();
+    for path in &paths {
+        cache.get(path).unwrap();
+    }
+    cache.next_batch();
+    let active = &paths[0];
+    let active_pixels = cache.get(active).unwrap();
+    let recent = &paths[79];
+    let recent_pixels = cache.get(recent).unwrap();
+    cache.retain(|path| path == active);
+    assert!(cache.len() <= 65, "one active + 64 inactive entries: {}", cache.len());
+    assert!(Rc::ptr_eq(&active_pixels, &cache.get(active).unwrap()), "active entries are never evicted");
+    assert!(Rc::ptr_eq(&recent_pixels, &cache.get(recent).unwrap()), "most recently used inactive entries stay");
+}
+
+#[test]
+fn inactive_entries_are_bounded_by_decoded_and_resized_bytes() {
+    let dir = scratch("bytes");
+    let paths: Vec<_> = (0..9)
+        .map(|i| {
+            let path = dir.join(format!("{i}.png"));
+            png(&path, 512, [i as u8, 32, 64]);
+            path
+        })
+        .collect();
+    let mut cache = ImageCache::default();
+    for path in &paths {
+        cache.get(path).unwrap();
+        cache.at_size(path, 1024, 1024).unwrap();
+    }
+    cache.next_batch();
+    cache.retain(|_| false);
+    assert!(cache.memory_bytes() <= 32 * 1024 * 1024, "inactive image bytes exceeded cap: {}", cache.memory_bytes());
+    assert!(cache.len() <= 6, "resized copies and run indexes count against the cap");
+}
+
+#[test]
+fn a_retained_entry_rechecks_file_metadata_before_reuse() {
+    let dir = scratch("metadata");
+    let path = dir.join("sprite.png");
+    png(&path, 8, [255, 0, 0]);
+    let mut cache = ImageCache::default();
+    assert_eq!(cache.get(&path).unwrap().width(), 8);
+    let original_size = cache.at_size(&path, 12, 12).unwrap();
+
+    cache.next_batch();
+    cache.retain(|_| false);
+    png(&path, 9, [0, 0, 255]);
+    cache.next_batch();
+    cache.retain(|_| false);
+    assert_eq!(cache.get(&path).unwrap().width(), 9, "an inactive picture is reloaded after its file changes");
+    let resized = cache.at_size(&path, 12, 12).unwrap();
+    assert!(!Rc::ptr_eq(&original_size, &resized), "size copies of changed files are discarded");
+    assert!(resized.pixels().iter().all(|pixel| pixel.blue() == 255 && pixel.red() == 0));
+    std::fs::remove_file(&path).unwrap();
+    cache.next_batch();
+    assert!(cache.get(&path).is_none(), "a deleted retained file is no longer shown");
+    png(&path, 10, [0, 255, 0]);
+    cache.next_batch();
+    assert_eq!(cache.get(&path).unwrap().width(), 10, "a file that returns invalidates the cached miss");
+}
+
+/// Optional timing loop with caller-provided frames. The renderer knows no
+/// application asset paths. Compare against the same test on the prior patch
+/// series; run serially under the benchmark lock.
+#[test]
+#[ignore = "timing; set SCARPE_IMAGE_BENCH_PATHS to four paths separated by the platform path separator"]
+fn animation_path_cycle_benchmark() {
+    let Some(paths) = std::env::var_os("SCARPE_IMAGE_BENCH_PATHS") else { return };
+    let paths: Vec<_> = std::env::split_paths(&paths).collect();
+    assert_eq!(paths.len(), 4);
+    let mut cache = ImageCache::default();
+    let started = std::time::Instant::now();
+    for i in 0..2400 {
+        let path = &paths[i % paths.len()];
+        cache.next_batch();
+        cache.retain(|shown| shown == path);
+        std::hint::black_box(cache.get(path).unwrap());
+        std::hint::black_box(cache.at_size(path, 21, 29).unwrap());
+    }
+    println!("2400 image path swaps: {:.3} ms, {} resamples", started.elapsed().as_secs_f64() * 1000.0, cache.take_resampled());
+}
