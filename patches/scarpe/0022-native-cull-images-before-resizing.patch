+/// A conservative device-space visibility check before making a resized copy.
+/// The one-pixel rim includes Skia's clip rounding and both the rounded blit and
+/// the unrounded sampling fallback (for pictures too large to cache).
+fn may_touch_canvas(canvas: &Canvas, r: Rect, clip: Option<Rect>) -> bool {
+    let base = canvas.base();
+    let (mut x0, mut y0, mut x1, mut y1) = (0.0f32, 0.0f32, canvas.pm.width() as f32, canvas.pm.height() as f32);
+    if let Some(clip) = clip {
+        x0 = x0.max(clip.x * base.sx + base.tx - 1.0);
+        y0 = y0.max(clip.y * base.sy + base.ty - 1.0);
+        x1 = x1.min(clip.right() * base.sx + base.tx + 1.0);
+        y1 = y1.min(clip.bottom() * base.sy + base.ty + 1.0);
+    }
+    r.x * base.sx + base.tx < x1 + 1.0
+        && r.y * base.sy + base.ty < y1 + 1.0
+        && r.right() * base.sx + base.tx > x0 - 1.0
+        && r.bottom() * base.sy + base.ty > y0 - 1.0
+}
