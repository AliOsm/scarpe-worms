diff --git a/test/native/deadline_wait_test.rb b/test/native/deadline_wait_test.rb
new file mode 100644
index 0000000..890d0d4
--- /dev/null
+++ b/test/native/deadline_wait_test.rb
@@ -0,0 +1,119 @@
+# frozen_string_literal: true
+
+require_relative "helper"
+require "minitest/mock"
+
+class DeadlineWaitTest < Minitest::Test
+  Wait = Scarpe::Native::DeadlineWait
+
+  def setup
+    @reader, @writer = IO.pipe
+    @wait = Wait.new([@reader])
+  end
+
+  def teardown
+    @wait.close
+    [@reader, @writer].each { |io| io.close unless io.closed? }
+  end
+
+  def test_timeout_does_not_report_the_timer_as_application_input
+    skip "precise timer unavailable" if @wait.backend == "select_timeout"
+    started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
+    assert_empty @wait.wait(0.005)
+    assert_operator Process.clock_gettime(Process::CLOCK_MONOTONIC) - started, :>=, 0.004
+  end
+
+  def test_input_wakes_a_long_deadline_and_rearming_does_not_see_a_stale_timer
+    @writer.write("wake")
+    assert_equal [@reader], @wait.wait(5)
+    assert_equal "wake", @reader.read(4)
+    assert_empty Array(@wait.wait(0.001))
+    started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
+    assert_empty Array(@wait.wait(0.015))
+    assert_operator Process.clock_gettime(Process::CLOCK_MONOTONIC) - started, :>=, 0.013
+    assert_nil @wait.wait(0)
+  end
+
+  def test_input_from_another_thread_interrupts_the_descriptor_wait
+    sender = Thread.new { sleep(0.01); @writer.write("input") }
+    assert_equal [@reader], @wait.wait(5)
+    assert_equal "input", @reader.read(5)
+  ensure
+    sender&.join
+  end
+
+  def test_close_is_idempotent_and_descriptor_is_not_inherited_by_exec
+    timer = @wait.instance_variable_get(:@timer)
+    skip "precise timer unavailable" unless timer
+    assert timer.io.close_on_exec?
+    @wait.close
+    @wait.close
+    assert timer.io.closed?
+  end
+
+  def test_portable_fallback_and_poll
+    @wait.close
+    @wait = Wait.new([@reader], timer: nil)
+    assert_equal "select_timeout", @wait.backend
+    assert_nil @wait.wait(0.001)
+    @writer.write("ready")
+    assert_equal [@reader], @wait.wait(0)
+  end
+
+  def test_linux_timer_slack_does_not_defer_animation_deadlines
+    skip "Linux timer-slack regression" unless RUBY_PLATFORM.include?("linux")
+    assert_equal "TimerFD", @wait.backend
+    require "fiddle"
+    prctl = Fiddle::Function.new(Fiddle::Handle::DEFAULT["prctl"],
+      [Fiddle::TYPE_INT, *Array.new(4, Fiddle::TYPE_LONG)], Fiddle::TYPE_INT)
+    original = prctl.call(30, 0, 0, 0, 0) # PR_GET_TIMERSLACK
+    assert_equal 0, prctl.call(29, 100_000_000, 0, 0, 0) # PR_SET_TIMERSLACK, 100 ms
+    samples = 12.times.map do
+      started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
+      assert_empty @wait.wait(0.010)
+      Process.clock_gettime(Process::CLOCK_MONOTONIC) - started
+    end
+    assert_operator samples.sum / samples.size, :<, 0.025, "coalescing delayed the UI timer"
+    assert_operator samples.max, :<, 0.070, "animation deadline stalled"
+  ensure
+    prctl.call(29, original, 0, 0, 0) if original && original >= 0
+  end
+
+  def test_timer_failure_keeps_input_working_and_reports_the_fallback
+    @wait.close
+    timer = Struct.new(:closed) do
+      def arm(_) = raise Errno::EINVAL, "timer registration"
+      def close = self.closed = true
+    end.new(false)
+    @wait = Wait.new([@reader], timer: timer)
+    @writer.write("input")
+    _, warning = capture_io { assert_equal [@reader], @wait.wait(0.01) }
+    assert timer.closed
+    assert_equal "select_timeout", @wait.backend
+    assert_match(/timer registration/, @wait.error)
+    assert_match(/precise timer disabled/, warning)
+    assert_equal [@reader], @wait.wait(0)
+  end
+
+  def test_darwin_requests_a_critical_one_shot_with_the_kevent64_abi
+    # Exercise the actual encoder on every platform; the real syscall path is
+    # also covered by the wait/input/cleanup tests when run on macOS.
+    timer = Wait::KqueueTimer.allocate
+    calls = []
+    timer.instance_variable_set(:@io, @reader)
+    timer.instance_variable_set(:@kevent, ->(*args) { calls << args; 0 })
+    timer.arm(0.016)
+    timer.cancel
+    fd, event, count, output, capacity, flags, timeout = calls.first
+    assert_equal @reader.fileno, fd
+    assert_equal 48, event.bytesize
+    assert_equal [1, -7, 0x11, 0x24, 16_000_000, 0, 0, 0], event.unpack(Wait::KqueueTimer::FORMAT)
+    assert_equal [1, nil, 0, 1, nil], [count, output, capacity, flags, timeout]
+    assert_equal 0x02, calls.last[1].unpack(Wait::KqueueTimer::FORMAT)[2]
+  end
+
+  def test_mac_uses_kqueue_instead_of_a_coalescible_select_timeout
+    skip "macOS syscall backend" unless RUBY_PLATFORM.include?("darwin")
+    assert_equal "KqueueTimer", @wait.backend
+  end
+end
