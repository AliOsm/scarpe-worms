diff --git a/lib/scarpe/native/deadline_wait.rb b/lib/scarpe/native/deadline_wait.rb
new file mode 100644
index 0000000..3b3494b
--- /dev/null
+++ b/lib/scarpe/native/deadline_wait.rb
@@ -0,0 +1,144 @@
+# frozen_string_literal: true
+
+module Scarpe::Native
+  # A select timeout is an ordinary, coalescible OS sleep. On macOS it can
+  # overshoot an animation deadline even when the process holds an activity
+  # assertion. Wait for a timer descriptor instead: pipes still wake immediately,
+  # and only the one pending deadline requests precise delivery. No polling or
+  # helper thread is needed. Other platforms retain the portable select path.
+  class DeadlineWait
+    attr_reader :error
+
+    def initialize(readers, timer: self.class.platform_timer)
+      @readers, @timer = readers, timer
+    end
+
+    def self.platform_timer
+      if RUBY_PLATFORM.include?("darwin")
+        KqueueTimer.new
+      elsif RUBY_PLATFORM.include?("linux") && [0].pack("l!").bytesize == 8
+        TimerFD.new
+      end
+    rescue LoadError, StandardError => error
+      warn "scarpe-native: precise timer unavailable: #{error.message}"
+      nil
+    end
+
+    def backend = @timer ? @timer.class.name.split("::").last : "select_timeout"
+
+    def wait(timeout)
+      timer = @timer
+      return IO.select(@readers, nil, nil, timeout)&.first unless timer && timeout.positive?
+
+      begin
+        timer.arm(timeout)
+      rescue SystemCallError => error
+        @error = error.message
+        warn "scarpe-native: precise timer disabled: #{@error}"
+        close
+        return IO.select(@readers, nil, nil, timeout)&.first
+      end
+      begin
+        ready = IO.select([*@readers, timer.io])&.first
+        ready&.reject { |io| io.equal?(timer.io) }
+      ensure
+        # An input event may win the race. Disarm its deadline so an idle app
+        # does not keep waking, and the next wait cannot consume a stale timer.
+        timer.cancel unless timer.io.closed?
+      end
+    end
+
+    def close
+      @timer&.close
+      @timer = nil
+    end
+
+    class NativeTimer
+      attr_reader :io
+
+      def initialize
+        require "fiddle"
+        @libc = Fiddle::Handle::DEFAULT
+        setup
+      rescue Exception
+        close
+        raise
+      end
+
+      def close = (@io.close if @io && !@io.closed?)
+
+      private
+
+      def function(name, arguments)
+        Fiddle::Function.new(@libc[name], arguments, Fiddle::TYPE_INT)
+      end
+
+      def check(result, operation)
+        raise SystemCallError.new(operation, Fiddle.last_error) if result < 0
+        result
+      end
+
+      def descriptor(fd)
+        @io = IO.for_fd(fd, autoclose: true)
+        @io.close_on_exec = true
+      end
+    end
+
+    class KqueueTimer < NativeTimer
+      # Darwin kevent64_s: ident, filter, flags, fflags, data, udata, ext[2].
+      # Use kevent64 (not kevent) for the documented NOTE_CRITICAL timer flag.
+      FORMAT = "Q s S L q Q Q Q"
+      EVFILT_TIMER = -7
+      EV_ADD_ONESHOT = 0x0001 | 0x0010
+      EV_DELETE = 0x0002
+      NOTE_NSECONDS_CRITICAL = 0x00000004 | 0x00000020
+      IMMEDIATE = 1
+
+      def arm(seconds)
+        change(EV_ADD_ONESHOT, [(seconds * 1_000_000_000).ceil, 1].max)
+      end
+
+      def cancel
+        change(EV_DELETE, 0)
+      rescue Errno::ENOENT
+        # An expired one-shot may already have been removed by the kernel.
+        nil
+      end
+
+      private
+
+      def setup
+        pointer, int = Fiddle::TYPE_VOIDP, Fiddle::TYPE_INT
+        @kevent = function("kevent64", [int, pointer, int, pointer, int, int, pointer])
+        descriptor(check(function("kqueue", []).call, "kqueue"))
+      end
+
+      def change(flags, nanos)
+        event = [1, EVFILT_TIMER, flags, NOTE_NSECONDS_CRITICAL, nanos, 0, 0, 0].pack(FORMAT)
+        check(@kevent.call(io.fileno, event, 1, nil, 0, IMMEDIATE, nil), "kevent64")
+      end
+    end
+
+    class TimerFD < NativeTimer
+      def arm(seconds)
+        nanos = [(seconds * 1_000_000_000).ceil, 1].max
+        set(nanos.div(1_000_000_000), nanos % 1_000_000_000)
+      end
+
+      def cancel = set(0, 0)
+
+      private
+
+      def setup
+        int, pointer = Fiddle::TYPE_INT, Fiddle::TYPE_VOIDP
+        @settime = function("timerfd_settime", [int, int, pointer, pointer])
+        descriptor(check(function("timerfd_create", [int, int]).call(1, 0), "timerfd_create")) # CLOCK_MONOTONIC
+      end
+
+      def set(seconds, nanos)
+        # Two timespecs: a zero repeat interval, then the one-shot deadline.
+        check(@settime.call(io.fileno, 0, [0, 0, seconds, nanos].pack("q4"), nil), "timerfd_settime")
+      end
+    end
+  end
+end
