@@ -41,6 +41,35 @@ class StatsTest < Minitest::Test
     end
   end
 
+  def test_wait_samples_preserve_early_wakes_and_scheduler_overshoot
+    with_stats("unused") do
+      times = [1.0, 1.010, 2.0, 2.080]
+      Stats.stub(:monotonic, -> { times.shift }) do
+        assert_equal :input, Stats.wait(0.020) { :input }
+        assert_raises(IOError) { Stats.wait(0.016) { raise IOError } }
+      end
+      samples = Stats.report["wait_samples"]
+      assert_equal 2, samples.size
+      assert_in_delta 20, samples[0][1], 0.001
+      assert_in_delta 10, samples[0][2], 0.001
+      assert_equal 0, samples[0][3]
+      assert_in_delta 64, samples[1][3], 0.001
+      assert_equal 2, Stats.report["phases"][:wait]["n"]
+    end
+  end
+
+  def test_wait_samples_are_bounded_and_returned_in_chronological_order
+    with_stats("unused") do
+      (Stats::MAX_WAIT_SAMPLES + 3).times { |i| Stats.wait(i.to_f) {} }
+      samples = Stats.report["wait_samples"]
+      assert_equal Stats::MAX_WAIT_SAMPLES, samples.size
+      assert_equal 3000, samples.first[1]
+      assert_equal (Stats::MAX_WAIT_SAMPLES + 2) * 1000, samples.last[1]
+      Stats.reset!
+      assert_empty Stats.report["wait_samples"]
+    end
+  end
+
