+    # Separate requested sleep from scheduler/GVL wake-up delays. Aggregate
+    # wait time alone mostly measures ordinary idle time, not missed frames.
+    def wait(requested)
+      return yield unless enabled?
+
+      started = monotonic
+      wall = Process.clock_gettime(Process::CLOCK_REALTIME)
+      begin
+        yield
+      ensure
+        elapsed = monotonic - started
+        add(:wait, elapsed)
+        @wait_samples ||= []
+        @wait_count ||= 0
+        @wait_samples[@wait_count % MAX_WAIT_SAMPLES] = [wall, requested * 1000.0, elapsed * 1000.0, [elapsed - requested, 0].max * 1000.0]
+        @wait_count += 1
+      end
+    end
