--- /dev/null
+++ b/test/native/windows_runtime_test.rb
@@ -0,0 +1,41 @@
+# frozen_string_literal: true
+
+require_relative "helper"
+
+# These tests run on POSIX and Windows. Invoke the interpreter explicitly;
+# Windows cannot execute a Ruby file by its shebang.
+class WindowsRuntimeTest < Minitest::Test
+  Child = Scarpe::Native::Child
+
+  def teardown
+    @child&.close
+  end
+
+  def test_pipe_handshake_and_graceful_shutdown_without_a_posix_shell
+    Dir.mktmpdir do |directory|
+      script = File.join(directory, "Renderer Équipe (test).rb")
+      FileUtils.cp(NativeTestHelpers::FAKE_CHILD, script)
+      @child = Child.new([RbConfig.ruby, "-EUTF-8", script])
+      assert_equal "fake", @child.version
+      assert_equal "pong", @child.request(:ping)["value"]
+      @child.close
+      assert @child.exit_status.success?
+    end
+  end
+
+  def test_a_child_that_ignores_pipe_eof_is_terminated
+    source = <<~'CODE'
+      STDOUT.sync = true
+      STDIN.gets
+      puts '{"t":"ready","v":1,"version":"stalled"}'
+      sleep 60
+      exit 77
+    CODE
+    @child = Child.new([RbConfig.ruby, "-e", source])
+    assert_equal "stalled", @child.version
+    @child.close(grace: 0.02)
+    refute_nil @child.exit_status, "the forced shutdown must reap the renderer"
+    # TerminateProcess can report exit code zero; it has no POSIX signal status.
+    refute_equal 77, @child.exit_status.exitstatus, "the child must not finish its stalled workload"
+  end
+end
