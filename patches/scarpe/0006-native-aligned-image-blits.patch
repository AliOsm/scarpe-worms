+++ b/native/tests/image_blit.rs
@@ -0,0 +1,27 @@
+use scarpe_native::{layout::Rect, paint::Canvas};
+use tiny_skia::{Color, FillRule, FilterQuality, Mask, PathBuilder, Pixmap, PixmapPaint, Transform};
+
+#[test]
+fn aligned_image_blit_matches_the_sampling_pipeline_with_alpha_and_clips() {
+    for alpha in [0, 1, 37, 128, 231, 255] {
+        let mut source = Pixmap::new(30, 25).unwrap();
+        source.fill(Color::from_rgba8(190, 83, 211, alpha));
+        for (x, y) in [(-7, -4), (0, 0), (7, 12), (40, 40)] {
+            for clip in [None, Some(Rect::new(11.0, 9.0, 26.0, 24.0))] {
+                let mut actual = Pixmap::new(48, 48).unwrap();
+                actual.fill(Color::from_rgba8(62, 127, 222, 190));
+                let mut expected = actual.clone();
+                let transform = Transform::from_translate(x as f32, y as f32);
+                Canvas::new(&mut actual, 1.0).image(source.as_ref(), transform, clip);
+                let mask = clip.map(|r| {
+                    let mut mask = Mask::new(48, 48).unwrap();
+                    let rect = tiny_skia::Rect::from_xywh(r.x, r.y, r.w, r.h).unwrap();
+                    mask.fill_path(&PathBuilder::from_rect(rect), FillRule::Winding, false, Transform::identity());
+                    mask
+                });
+                expected.draw_pixmap(0, 0, source.as_ref(), &PixmapPaint {quality: FilterQuality::Nearest, ..Default::default()}, transform, mask.as_ref());
+                assert_eq!(actual.data(), expected.data(), "alpha {alpha}, at {x},{y}, clip {clip:?}");
+            }
+        }
+    }
+}
