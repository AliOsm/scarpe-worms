+    /// Already-resampled pictures at integer pixels need no rasterizer or sampling
+    /// shader. This is also the common case for images clipped by fixed-size slots.
+    fn blit_aligned_image(&mut self, image: tiny_skia::PixmapRef<'_>, t: Transform, clip: Option<Rect>) -> bool {
+        if t.sx != 1.0 || t.sy != 1.0 || t.kx != 0.0 || t.ky != 0.0 ||
+            !t.tx.is_finite() || !t.ty.is_finite() || t.tx != t.tx.round() || t.ty != t.ty.round() ||
+            t.tx.abs() > MAX_DEVICE_REACH || t.ty.abs() > MAX_DEVICE_REACH { return false; }
+        let (dx, dy) = (t.tx as i32, t.ty as i32);
+        let (mut x0, mut y0) = (dx.max(0), dy.max(0));
+        let (mut x1, mut y1) = ((dx + image.width() as i32).min(self.pm.width() as i32), (dy + image.height() as i32).min(self.pm.height() as i32));
+        if let Some(c) = clip {
+            let base = self.base();
+            let edges = [c.x * base.sx + base.tx, c.y * base.sy + base.ty,
+                c.right() * base.sx + base.tx, c.bottom() * base.sy + base.ty];
+            if edges.iter().any(|e| !e.is_finite() || *e != e.round() || e.abs() > MAX_DEVICE_REACH) { return false; }
+            x0 = x0.max(edges[0] as i32); y0 = y0.max(edges[1] as i32);
+            x1 = x1.min(edges[2] as i32); y1 = y1.min(edges[3] as i32);
+        }
+        if x1 <= x0 || y1 <= y0 { return true; }
+        let sw = image.width() as usize * 4;
+        let dw = self.pm.width() as usize * 4;
+        let len = (x1 - x0) as usize * 4;
+        let source = image.data();
+        let dest = self.pm.data_mut();
+        for y in y0..y1 {
+            let from = (y - dy) as usize * sw + (x0 - dx) as usize * 4;
+            let to = y as usize * dw + x0 as usize * 4;
+            for (s, d) in source[from..from + len].chunks_exact(4).zip(dest[to..to + len].chunks_exact_mut(4)) {
+                match s[3] {
+                    0 => {},
+                    255 => d.copy_from_slice(s),
+                    alpha => {
+                        let inv = 255 - alpha as u32;
+                        for c in 0..4 { d[c] = (s[c] as u32 + (d[c] as u32 * inv + 127) / 255).min(255) as u8; }
+                    }
+                }
+            }
+        }
+        true
+    }
