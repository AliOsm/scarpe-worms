         assert!(pacing.due().is_none());
     }
 
@@ -98,7 +99,7 @@ mod tests {
         let t0 = Instant::now();
         pacing.drawing(t0);
         pacing.drawing(ms(t0, 1));
-        assert!(!pacing.want_frame(ms(t0, 16)));
-        assert!(pacing.want_frame(ms(t0, 17)));
+        assert!(!pacing.want_frame(ms(t0, 9)));
+        assert!(pacing.want_frame(ms(t0, 10)));
     }
 }
