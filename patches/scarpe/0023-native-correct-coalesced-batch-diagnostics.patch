+    #[test]
+    fn coalesced_chunks_share_the_first_redraw_and_never_reappear_on_idle_redraws() {
+        let mut stats = Stats::new(None);
+        stats.batch_received(3);
+        stats.batch_settled(true);
+        stats.batch_received(5);
+        stats.batch_settled(true);
+        stats.redraw_started();
+        let first = stats.to_json()["batches"].clone();
+        assert!(first[0][6].is_number());
+        assert_eq!(first[0][6], first[1][6], "both chunks reached the same first redraw");
+        assert_eq!(first[0][7], first[1][7]);
+        stats.redraw_started();
+        stats.batch_settled(true);
+        assert_eq!(stats.to_json()["batches"], first, "idle callbacks must not rewrite chunk attribution");
+
+        stats.batch_received(1);
+        stats.batch_settled(true);
+        stats.redraw_started();
+        let json = stats.to_json();
+        assert_eq!(json["batches"][0], first[0]);
+        assert_eq!(json["batches"][1], first[1]);
+        assert!(json["batches"][2][6].as_f64().unwrap() >= first[1][6].as_f64().unwrap());
+        assert_eq!(json["batch_diagnostics_version"], 2);
+    }
+
+    #[test]
+    fn fragmented_protocol_chunks_stay_unsettled_until_redraw_is_permitted() {
+        let mut stats = Stats::new(None);
+        stats.batch_received(3);
+        stats.batch_settled(false);
+        stats.batch_received(5);
+        stats.batch_settled(false);
+        stats.redraw_started();
+        for row in stats.to_json()["batches"].as_array().unwrap() {
+            assert!(row[4].is_null());
+            assert!(row[6].is_null());
+        }
+        stats.batch_received(1); // The flush that completes the fragmented update.
+        stats.batch_settled(true);
+        stats.redraw_started();
+        let json = stats.to_json();
+        let rows = json["batches"].as_array().unwrap();
+        for row in rows {
+            assert_eq!(row[4], rows[2][4]);
+            assert_eq!(row[6], rows[2][6]);
+            assert!(row[2].as_f64().unwrap() <= row[4].as_f64().unwrap());
+            assert!(row[4].as_f64().unwrap() <= row[6].as_f64().unwrap());
+        }
+    }
+
+    #[test]
+    fn bounded_chunk_eviction_preserves_pending_settle_and_redraw_attribution() {
+        let mut stats = Stats::new(None);
+        stats.batch_received(1);
+        stats.batch_settled(true);
+        stats.redraw_started();
+        for _ in 0..MAX_SAMPLES + 3 {
+            stats.batch_received(2);
+            stats.batch_settled(false);
+        }
+        stats.batch_settled(true);
+        stats.redraw_started();
+        let json = stats.to_json();
+        let rows = json["batches"].as_array().unwrap();
+        assert_eq!(rows.len(), MAX_SAMPLES);
+        assert_eq!(rows[0][0], 5);
+        assert!(rows[0][6].is_number());
+        for row in rows {
+            assert_eq!(row[4], rows[0][4]);
+            assert_eq!(row[6], rows[0][6]);
+        }
     }
 
