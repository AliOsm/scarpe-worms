diff --git a/native/tests/unchanged_props.rs b/native/tests/unchanged_props.rs
new file mode 100644
index 0000000..18e6375
--- /dev/null
+++ b/native/tests/unchanged_props.rs
@@ -0,0 +1,25 @@
+mod common;
+use common::{app, create, Harness};
+use scarpe_native::paint::damage::{FrameMemory, Repaint};
+use serde_json::json;
+
+#[test]
+fn unchanged_props_keep_layout_and_pixels() {
+    let mut h = Harness::new();
+    h.feed(&app(480, 320, &[
+        create(3, "Stack", 2, json!({"left": 0, "top": 0, "width": 480, "height": 300, "hidden": false})),
+        create(4, "Para", 3, json!({"text_items": ["Hello"], "left": 12, "top": 12})),
+    ]));
+    let mut frame = h.rt.picture(1, 1.0).unwrap();
+    let mut memory = FrameMemory::default();
+    h.rt.repaint(1, &mut frame, 1.0, &mut memory);
+    let revision = h.rt.revisions.now();
+    for _ in 0..5 {
+        h.feed("{\"t\":\"props\",\"id\":3,\"props\":{\"hidden\":false,\"width\":480}}\n{\"t\":\"props\",\"id\":4,\"props\":{\"text_items\":[\"Hello\"],\"left\":12}}\n{\"t\":\"flush\"}\n");
+        assert_eq!(h.rt.revisions.now(), revision);
+        assert_eq!(h.rt.repaint(1, &mut frame, 1.0, &mut memory), Repaint::Nothing);
+    }
+    h.feed("{\"t\":\"props\",\"id\":4,\"props\":{\"text_items\":[\"Changed\"]}}\n{\"t\":\"flush\"}\n");
+    assert!(h.rt.revisions.now() > revision);
+    assert!(matches!(h.rt.repaint(1, &mut frame, 1.0, &mut memory), Repaint::Rects(_)));
+}
