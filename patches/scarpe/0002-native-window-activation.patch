+    /// Notify applications before synthetic releases so a charged action can be
+    /// cancelled. A lost mouse press must not activate a button after returning.
+    pub fn window_focus(&mut self, app: Id, active: bool) {
+        let Some(view) = self.views.get_mut(&app) else { return };
+        if view.ui.window_active == Some(active) {
+            return;
+        }
+        view.ui.window_active = Some(active);
+        if active {
+            self.active_app = Some(app);
+        }
+        for (item, _) in self.subscriptions(app, "activation") {
+            self.out.event("activation", Some(item), vec![json!(active)]);
+        }
+        if !active {
+            self.release_keys(app);
+            let view = self.views.get_mut(&app).expect("view");
+            view.ui.pressed = None;
+            view.ui.buttons = 0;
+            view.ui.modifiers = Modifiers::default();
+            self.send_mouse_state(app);
+            self.request_redraw(app);
+        }
+    }
+
