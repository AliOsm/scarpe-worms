diff --git a/native/tests/window_activation.rs b/native/tests/window_activation.rs
new file mode 100644
index 0000000..4020d72
--- /dev/null
+++ b/native/tests/window_activation.rs
@@ -0,0 +1,46 @@
+mod common;
+use common::{app, create, events, named, Harness};
+use serde_json::json;
+
+fn scene() -> Harness {
+    let mut h = Harness::new();
+    h.feed(&app(300, 200, &[
+        create(3, "SubscriptionItem", 2, json!({"shoes_api_name":"activation","args":[]})),
+        create(4, "SubscriptionItem", 2, json!({"shoes_api_name":"keyup","args":[]})),
+        create(5, "Button", 2, json!({"text":"Fire","width":100,"height":40})),
+    ]));
+    h
+}
+
+#[test]
+fn deactivation_precedes_releases_and_duplicate_transitions_are_silent() {
+    let mut h = scene();
+    h.value(json!({"op":"key_down","key":" "}));
+    let (evs, _) = h.req(json!({"op":"window_focus","active":false}));
+    let evs = events(&evs);
+    let relevant: Vec<_> = evs.iter().filter(|e| e.0 == "activation" || e.0 == "keyup").collect();
+    assert_eq!(relevant[0].0, "activation");
+    assert_eq!(relevant[0].2, json!([false]));
+    assert_eq!(relevant[1].0, "keyup");
+    assert_eq!(relevant[1].2, json!([" "]));
+    assert!(h.rt.views[&1].ui.held_keys.is_empty());
+    let (evs, _) = h.req(json!({"op":"window_focus","active":false}));
+    assert!(named(&events(&evs), "activation").is_empty());
+    let (evs, _) = h.req(json!({"op":"window_focus","active":true}));
+    assert_eq!(named(&events(&evs), "activation")[0].2, json!([true]));
+}
+
+#[test]
+fn interrupted_mouse_press_cannot_click_a_button_on_return() {
+    let mut h = scene();
+    h.value(json!({"op":"mouse","action":"down","x":30,"y":20}));
+    assert!(h.rt.views[&1].ui.pressed.is_some());
+    h.value(json!({"op":"window_focus","active":false}));
+    assert!(h.rt.views[&1].ui.pressed.is_none());
+    assert_eq!(h.rt.views[&1].ui.buttons, 0);
+    h.value(json!({"op":"window_focus","active":true}));
+    let (evs, _) = h.req(json!({"op":"mouse","action":"up","x":30,"y":20}));
+    assert!(named(&events(&evs), "click").is_empty());
+    let (evs, _) = h.req(json!({"op":"click","target":{"id":5}}));
+    assert_eq!(named(&events(&evs), "click").len(), 1);
+}
